[Desktop Entry]
Type=Application
Name=m3 Browser
GenericName=Web Browser
Comment=Browse the web with Material 3 Expressive style
Exec=m3-browser %U
Icon=web-browser
Terminal=false
StartupNotify=true
DBusActivatable=false
Categories=Network;WebBrowser;
MimeType=text/html;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;
Keywords=web;internet;browser;www;
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=m3-browser
