[Desktop Entry]
Type=Application
Name=Files
GenericName=File Manager
Comment=Browse and organise your files
Exec=m3-files %U
Icon=system-file-manager
Terminal=false
Categories=System;FileTools;FileManager;GTK;
MimeType=inode/directory;
Keywords=folder;directory;manager;explorer;browse;
StartupNotify=true
DBusActivatable=false
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=m3-files
